# A remote, served on its own: index.html is the standalone app, remoteEntry.js is what a host loads.
server {
  listen 80;
  root /usr/share/nginx/html;
  resolver 127.0.0.11 valid=10s ipv6=off;

  # A host on another origin must be able to fetch the entry file and its chunks.
  add_header Access-Control-Allow-Origin * always;

  # Entry points change on every release and must never be cached; hashed chunks can be.
  location = /remoteEntry.js { add_header Cache-Control "no-store" always; add_header Access-Control-Allow-Origin * always; }
  location = /index.html { add_header Cache-Control "no-store" always; }

  # Standalone mode reaches the services through the same origin, so there is no CORS to configure.
  location /api/people/ { set $upstream http://people-api:4001; proxy_pass $upstream; }
  location /api/delivery/ { set $upstream http://delivery-api:4002; proxy_pass $upstream; }

  location / { try_files $uri /index.html; }
}
